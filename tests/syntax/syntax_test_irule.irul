# SYNTAX TEST "Packages/iRules/iRule.sublime-syntax"

# ------------ #
# Simple Event
# ------------ #

when CLIENT_ACCEPTED {
# <- keyword.other.irule
#    ^^^^^^^^^^^^^^^ entity.name.function.irule
    log local0.debug "nothing"
#   ^^^ meta.block.irule keyword.other.irule
#       ^^^^^^^^^^^^^^^^^^^^^^^ meta.block.irule
}

# -------------- #
# Priority Event
# -------------- #

when CLIENT_ACCEPTED priority 350 {
# <- keyword.other.irule
#    ^^^^^^^^^^^^^^^ entity.name.function.irule
#                    ^^^^^^^^ keyword.other.irule
#                             ^^^ constant.numeric.integer.irule
    log local0.debug "nothing"
#   ^^^ meta.block.irule keyword.other.irule
#       ^^^^^^^^^^^^^^^^^^^^^^^ meta.block.irule
#                    ^ meta.block.irule string.quoted.double.irule punctuation.definition.string.begin.irule
#                     ^^^^^^^^ meta.block.irule string.quoted.double.irule
#                            ^ meta.block.irule string.quoted.double.irule punctuation.definition.string.end.irule
}

# ----------------- #
# Line continuation
# ----------------- #

set MyDict [list\
    Key1 {Key Value 1}\
#                     ^ punctuation.separator.continuation
]

pg_select $database \
"SELECT abc, def FROM xyz"
# <- string

pg_select $database \
"SELECT abc, def FROM xyz" \
data
# <- - variable.function

becs::wizFrame -info [becs_infobody "interface.jpg" \
    "Specify VID parameters<br><br><strong>VID groups</strong> can be used to build ranges that is added to the VID range field."] \
    -title "$ifacename VID parameters"
# ^ - meta.substitution

if {[catch {becs::objectCreate -class interface \
        -flags "statistics,interfaceautoprobe" \
        -name $aggrname -role $extra_role \
                        -parameters [array get params] \
        -opaque [list "becs.editor" "ifrole.tcl"] \
        -parentoid $aggr_attach_oid} err]} {
return "Creating aggregator interface $aggrname under element/management element-module OID $aggr_attach_oid: $err"
}
#^ - meta.block
#^ - meta.substitution

# --------------------------------- #
# Brace strings are not code blocks
# --------------------------------- #

when HTTP_REQUEST {
    lappend mylist {abc}
#                  ^^^^^ string.quoted.brace.irule
}

# ------------------------------------------ #
# Unknown events are flagged but parsing continues
# ------------------------------------------ #

when NOT_A_REAL_EVENT {
#    ^^^^^^^^^^^^^^^^ invalid.illegal.unknown-event.irule
    log local0. "still parsed"
#   ^^^ keyword.other.irule
}

when CLIENT_ACCEPTED {
#    ^^^^^^^^^^^^^^^ entity.name.function.irule
    LSN::inbound-entry get
#   ^^^^^^^^^^^^^^^^^^ keyword.other.irule
    if {$a} { set x 1 }
#             ^^^ keyword.other.irule
}

# ------------------------------------ #
# Deprecated events still get a body
# ------------------------------------ #

when HTTP_CLASS_SELECTED {
#    ^^^^^^^^^^^^^^^^^^^ invalid.deprecated.irule
    log local0. "body"
#   ^^^ keyword.other.irule
}

# ------------------------------------------- #
# Data corrections (B4)
# ------------------------------------------- #

when QOE_PARSE_DONE {
#    ^^^^^^^^^^^^^^ entity.name.function.irule
    ROUTE::age
#   ^^^^^^^^^^ keyword.other.irule
    ASM::violation_data
#   ^^^^^^^^^^^^^^^^^^^ invalid.deprecated.irule
}
